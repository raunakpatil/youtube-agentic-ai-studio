# YAAS — youtube-agentic-ai-studio · API keys
# Copy this file to .env (git-ignored) — or just paste keys in the app's Settings page.
# Every key is free and optional; YAAS works without any of them.

# Recommended — much better scripts (aistudio.google.com/apikey)
GEMINI_API_KEY=

# Stock photos (pexels.com/api · pixabay.com/api/docs)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Backup AI when Gemini runs out of free quota (console.groq.com/keys · openrouter.ai/keys)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Live channel stats on Home (YouTube Data API v3 key + your channel ID or @handle)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
